{
  "expo": {
    "name": "Floor Frame Viro",
    "slug": "floor-frame-viro",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "cz.koval.floorframe.viro",
      "appleTeamId": "U539BVM9GN",
      "infoPlist": {
        "UIRequiredDeviceCapabilities": [
          "arkit"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "platforms": [
      "ios"
    ],
    "plugins": [
      [
        "@reactvision/react-viro",
        {
          "provider": "none",
          "ios": {
            "includeARCore": false,
            "cameraUsagePermission": "Floor Frame uses the camera to detect surfaces and place a life-size rectangle in your room."
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Floor Frame uses the camera to detect surfaces and place a life-size rectangle in your room.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true
          }
        }
      ]
    ]
  }
}
